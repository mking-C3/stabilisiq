# Required. Anthropic API key used by /app/api/chat/route.ts
ANTHROPIC_API_KEY=sk-ant-...

# Required. n8n webhook that persists contact-form submissions
# (StabilisIQ — SMS Opt-In Capture workflow -> sms_optins data table).
# Opt-in records are compliance evidence; if this is unset the API route
# fails loudly rather than silently dropping submissions.
N8N_OPTIN_WEBHOOK_URL=https://stabilis.app.n8n.cloud/webhook/sms-optin
